<!DOCTYPE html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= title %></title>
    <link rel="stylesheet" href="/assets/calendrier.css" />
  </head>
  <body>
    <main id="calendar" data-calendar-id="<%= calendarId %>">
      <a class="back-link" href="/">&larr; Mes agendas</a>

      <header class="calendar-toolbar">
        <h1 id="period-label"></h1>

        <div class="view-switch" role="group" aria-label="Choisir la vue">
          <button type="button" data-view="day" aria-pressed="false">Jour</button>
          <button type="button" data-view="week" aria-pressed="true">Semaine</button>
          <button type="button" data-view="month" aria-pressed="false">Mois</button>
        </div>

        <nav class="period-navigation" aria-label="Changer de période">
          <button type="button" id="add-event" aria-label="Ajouter un événement">&plus;</button>
          <button type="button" id="previous-period" aria-label="Période précédente">&lt;</button>
          <button type="button" id="current-period">Aujourd'hui</button>
          <button type="button" id="next-period" aria-label="Période suivante">&gt;</button>
        </nav>
      </header>

      <p id="calendar-message" role="alert" aria-live="polite" hidden></p>

      <div class="calendar-scroll">
        <div id="calendar-grid"></div>
      </div>
    </main>

    <script src="/assets/calendrier.js" defer></script>
  </body>
</html>