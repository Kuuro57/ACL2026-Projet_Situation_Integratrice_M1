<!DOCTYPE html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= title %></title>
    <link rel="stylesheet" href="/assets/creation-compte.css" />
  </head>
  <body>
    <main>
      <h1>Créer un agenda</h1>

      <form id="creation-agenda-form" novalidate>
        <div class="form-field">
          <label for="name">Nom de l’agenda</label>
          <input
            id="name"
            name="name"
            type="text"
            maxlength="100"
            autocomplete="off"
            required
          />
        </div>

        <p id="form-message" role="alert" aria-live="polite"></p>
        <button type="submit">Créer l’agenda</button>
      </form>
      <p class="form-link"><a href="/">Retour au menu principal</a></p>
    </main>

    <script src="/assets/creation-agenda.js" defer></script>
  </body>
</html>
